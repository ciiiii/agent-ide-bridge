{
  "name": "agent-ide-bridge",
  "displayName": "Agent IDE Bridge",
  "description": "Multi-client IDE diff bridge: lets several Claude Code sessions share one code-server window (in-editor diffs, accept/reject). Replaces the single-client official integration.",
  "version": "0.1.0",
  "publisher": "cai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ciiiii/agent-ide-bridge.git"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentIdeBridge.showStatus",
        "title": "Agent IDE Bridge: Show Status"
      },
      {
        "command": "claude-code.acceptProposedDiff",
        "title": "Agent IDE Bridge: Accept Proposed Diff"
      },
      {
        "command": "claude-code.rejectProposedDiff",
        "title": "Agent IDE Bridge: Reject Proposed Diff"
      }
    ],
    "keybindings": [
      {
        "command": "claude-code.acceptProposedDiff",
        "key": "cmd+enter",
        "when": "agentIdeBridge.diffActive"
      },
      {
        "command": "claude-code.rejectProposedDiff",
        "key": "cmd+backspace",
        "when": "agentIdeBridge.diffActive"
      }
    ],
    "configuration": {
      "title": "Agent IDE Bridge",
      "properties": {
        "agentIdeBridge.port": {
          "type": "number",
          "default": 8991,
          "description": "Fixed localhost port for the IDE bridge, kept stable across reloads so sessions can reconnect without re-selecting via /ide. Set 0 for a random port."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies -o agent-ide-bridge.vsix"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.94.0",
    "@types/ws": "^8.5.12",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
